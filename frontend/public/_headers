  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

# Hashed assets: 1 year immutable cache (safe because filename hashes change on rebuild)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemap and robots
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: all

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# AI & LLM Crawl files
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: all

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: all
