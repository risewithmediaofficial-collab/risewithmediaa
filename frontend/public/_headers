# Cache-Control & Crawler Headers for Cloudflare Pages / Workers

# HTML Documents & Routes: Never cache HTML so users & crawlers receive latest updates
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Link: <https://risewithmedia.com/llms.txt>; rel="alternate"; type="text/plain"

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Link: <https://risewithmedia.com/llms.txt>; rel="alternate"; type="text/plain"

/
