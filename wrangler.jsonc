{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "risewithmediaa",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cd frontend && npm install && npm run build"
  },
  "assets": {
    "directory": "frontend/dist"
  }
}
